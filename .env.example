# Root environment template — copy to .env for docker-compose
NODE_ENV=production

# MongoDB (service name `mongo` inside the compose network)
MONGO_URI=mongodb://mongo:27017/whiteboard

# Redis is OPTIONAL. Leave empty to use the built-in in-memory fallback
# (single-process refresh-token store + pub/sub fan-out).
# Set a real URL only when scaling to multiple server instances.
REDIS_URL=

# Server port
PORT=4000
