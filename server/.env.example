# Server environment template — copy to server/.env for local dev
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://localhost:27017/whiteboard

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Auth secrets (change in production!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMTP (optional in dev — falls back to console transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Whiteboard <no-reply@whiteboard.local>
